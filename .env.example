# Copy to .env and fill in real values. Never commit .env to git.

# OpenAI API key for the target agent
OPENAI_API_KEY=sk-...

# Together AI key — serves the open-weight Inkling model for Arms C/D via its
# OpenAI-compatible endpoint (native tool calling). Required only for those arms.
# TOGETHER_API_KEY=...

# OpenAI-compatible base URL for the agent model (open-weight arms only). Set this
# for Arm C/D so tool schemas are forwarded intact; leave unset for Arm A/B.
# AGENT_API_BASE=https://api.together.xyz/v1

# Model the TaskEvolve agent (the LLM under test) uses. Required.
#   Arm A/B (closed):      gpt-4.1
#   Arm C/D (open-weight): openai/thinkingmachines/Inkling   (with AGENT_API_BASE above)
AGENT_MODEL=gpt-4.1

# TAU2-bench model for the user simulator (defaults to gpt-4o if unset)
# USER_MODEL=gpt-4o

# Model the iterator's editor uses to propose harness edits (Milestone 2).
# A strong closed-weight model, separate from AGENT_MODEL.
# ITERATOR_MODEL=anthropic/claude-opus-4-8
# Set when the editor model rejects `temperature` (e.g. Opus 4.8), so it's dropped
# from the editor call (mirrors AGENT_NO_TEMPERATURE).
# ITERATOR_NO_TEMPERATURE=1

# Tinker API key for fine-tuning Inkling (Arm D). The Tinker SDK reads
# TINKER_API_KEY; settings/config.py bridges this TINKER_KEY -> TINKER_API_KEY
# at import so .env only needs one name.
# TINKER_KEY=...

# Arm D (tuned Inkling) — path A resolved 2026-08-04: serve the Tinker LoRA
# via Together's OpenAI-compat endpoint, exactly like Arm C. Flow:
#   1. Train (arm_d/train.py)   -> tinker://<run-id>/sampler_weights/<step>
#   2. Export (arm_d/serving.py::export_adapter_to_hf) -> HF repo:
#        tinker checkpoint push-hf tinker://<run-id>/sampler_weights/<step> --repo <hf-repo>
#   3. Deploy (Together console, USER step): Models -> Upload a model ->
#      type=Adapter, base=thinkingmachines/inkling, Source URL=<hf-repo>
#      (+ HF token if private) -> Together returns a served model_name.
#   4. Serve (this .env, mirrors Arm C):
# ARM_D_TUNED_MODEL_ID=<together-served-adapter-id>
# AGENT_MODEL=openai/<served_id>
# AGENT_API_BASE=https://api.together.xyz/v1
# TOGETHER_API_KEY=...   (same key Arm C uses)
# ARM_D_TUNED_MODEL_ID must match the bare <served_id> used in AGENT_MODEL —
# settings/pricing.py::register_pricing() reads it to price the actual served
# id at Inkling's per-token rate (else that model prices at $0).
