# Copy to .env and fill in real values. Never commit .env to git.

# OpenAI API key for the target agent
OPENAI_API_KEY=sk-...

# Together AI key — serves the open-weight Inkling model for Arms C/D via its
# OpenAI-compatible endpoint (native tool calling). Required only for those arms.
# TOGETHER_API_KEY=...

# OpenAI-compatible base URL for the agent model (open-weight arms only). Set this
# for Arm C/D so tool schemas are forwarded intact; leave unset for Arm A/B.
# AGENT_API_BASE=https://api.together.xyz/v1

# Model the TaskEvolve agent (the LLM under test) uses. Required.
#   Arm A/B (closed):      gpt-4.1
#   Arm C/D (open-weight): openai/thinkingmachines/Inkling   (with AGENT_API_BASE above)
AGENT_MODEL=gpt-4.1

# TAU2-bench model for the user simulator (defaults to gpt-4o if unset)
# USER_MODEL=gpt-4o

# Model the iterator's editor uses to propose harness edits (Milestone 2).
# A strong closed-weight model, separate from AGENT_MODEL.
# ITERATOR_MODEL=claude-opus-4-8   
    