# Copy to .env and fill in real values. Never commit .env to git.
#
# Every variable below is read by settings/config.py, arm_d/serving_shim.py, or
# settings/pricing.py. Which ones you need depends on the arm you are running.
# See the "Reproducing the study" section in README.md.


# ---------------------------------------------------------------------------
# Provider credentials
# ---------------------------------------------------------------------------

# OpenAI. Required for every arm, because TAU2's user simulator is an OpenAI
# model in all of them, even when the agent under test is not.
OPENAI_API_KEY=sk-...

# Anthropic. Required whenever AGENT_MODEL or ITERATOR_MODEL names a Claude
# model, so for the Opus 4.8 reference arm, the iterator-optimized arm, and the
# Opus teacher that produces the fine-tuning trajectories. No repo code reads
# this name; litellm picks it up from the environment.
# ANTHROPIC_API_KEY=sk-ant-...

# Together AI. Serves the full open-weight Inkling model through its
# OpenAI-compatible endpoint. Also the fallback value for AGENT_API_KEY.
# TOGETHER_API_KEY=...

# Tinker. Trains the Arm D LoRA adapter and serves both open-weight systems
# through the local shim. The Tinker SDK reads TINKER_API_KEY, and
# settings/config.py bridges TINKER_KEY into it at import, so .env needs only
# this one name.
# TINKER_KEY=...


# ---------------------------------------------------------------------------
# The system under test
# ---------------------------------------------------------------------------

# The model the TaskEvolve agent runs. Required, with no default.
#   gpt-4.1                                  Arm A baseline
#   anthropic/claude-opus-4-8                closed frontier reference
#   openai/thinkingmachines/Inkling          full Inkling through Together
#   openai/thinkingmachines/Inkling-Small    base control through the shim
#   openai/armd-inkling-small-tuned          fine-tuned adapter through the shim
AGENT_MODEL=gpt-4.1

# OpenAI-compatible base URL for the agent, set for open-weight arms only.
# Leave unset for the closed arms so litellm uses the native provider.
# Routing an open-weight model through litellm's together_ai provider instead
# of this openai-plus-base-url path silently drops the tool schemas, so the
# agent gets no tools and every task fails.
#   https://api.together.xyz/v1   full Inkling through Together
#   http://localhost:8100/v1      Inkling-Small and the adapter through the shim
# AGENT_API_BASE=https://api.together.xyz/v1

# Key for AGENT_API_BASE. Falls back to TOGETHER_API_KEY when unset, so a
# Together run needs only that key. The local shim ignores the value.
# AGENT_API_KEY=...

# Set to 1 when the agent model rejects the temperature parameter, which Opus
# 4.8 does. litellm will not strip it on its own, so every Opus run needs this.
# AGENT_NO_TEMPERATURE=1

# Labels the harness generation in each experiments/results.csv row. Defaults to
# v0.1, the frozen static harness. This is a label only: the harness itself is
# the state of target_agent/harness.py, model_routing.py and prompts/.
# HARNESS_VERSION=v0.1

# The user simulator. Unset means TAU2's default, gpt-4.1-2025-04-14, which is
# what every recorded run used. Changing it breaks comparability with the ledger.
# USER_MODEL=gpt-4.1-2025-04-14


# ---------------------------------------------------------------------------
# The iterator's editor, for the harness search only
# ---------------------------------------------------------------------------

# The model that reads run evidence and proposes one harness edit per iteration.
# Separate from AGENT_MODEL, since the editor is the optimizer and the agent is
# the thing being optimized. The reported search used an Opus editor.
# ITERATOR_MODEL=anthropic/claude-opus-4-8

# Same temperature fix as AGENT_NO_TEMPERATURE, applied to the editor call.
# ITERATOR_NO_TEMPERATURE=1


# ---------------------------------------------------------------------------
# Arm D serving
# ---------------------------------------------------------------------------

# The served adapter id. settings/pricing.py::register_pricing() reads it to
# price the served model at Inkling-Small's per-token rate. When it does not
# match the bare id in AGENT_MODEL, the run records a cost of $0.
# ARM_D_TUNED_MODEL_ID=armd-inkling-small-tuned

# tinker:// checkpoint for the retail-only adapter ablation, read by
# arm_d/serving_shim.py. Unset means the shim refuses that model id.
# ARM_D_RETAIL_TUNED_PATH=tinker://<run-id>/sampler_weights/<name>

# Superseded path, kept for the record. The study first tried serving the LoRA
# through Together rather than the local shim, by exporting the adapter to a
# Hugging Face repo and uploading it in the Together console:
#   1. train, which yields tinker://<run-id>/sampler_weights/<step>
#   2. tinker checkpoint push-hf <that path> --repo <hf-repo>
#   3. Together console, Models, Upload a model, type Adapter,
#      base thinkingmachines/inkling, Source URL <hf-repo>, plus an HF token
#      when the repo is private
#   4. set AGENT_MODEL=openai/<served_id> and AGENT_API_BASE to Together
# This was abandoned because no serverless provider will host a custom LoRA,
# and because the base control has to traverse the same stack as the adapter for
# the comparison to isolate the adapter. Both now run through the local shim.
