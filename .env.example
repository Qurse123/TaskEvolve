# Copy to .env and fill in real values. Never commit .env to git.

# OpenAI API key for the target agent
OPENAI_API_KEY=sk-...

# Model the TaskEvolve agent (the closed LLM under test) uses. Required.
AGENT_MODEL=gpt-4.1

# TAU2-bench model for the user simulator (defaults to gpt-4o if unset)
# USER_MODEL=gpt-4o

# Model the iterator's editor uses to propose harness edits (Milestone 2).
# A strong closed-weight model, separate from AGENT_MODEL.
# ITERATOR_MODEL=claude-opus-4-8   
