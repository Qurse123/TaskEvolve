# Copy to .env and fill in real values. Never commit .env to git.

# OpenAI API key for the target agent
OPENAI_API_KEY=sk-...

# Langfuse observability (get from cloud.langfuse.com or self-hosted)
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

# Set to True to emit Langfuse traces from every generate() call
USE_LANGFUSE=True

# TAU2-bench model for the user simulator (defaults to gpt-4o if unset)
# USER_MODEL=gpt-4o
