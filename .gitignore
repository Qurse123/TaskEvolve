.env

# Python build artifacts
__pycache__/
*.pyc

# Vendored external dependency (cloned + built locally, never committed)
vendor/

# Run artifacts. Regenerable only by paying for the runs again, so the two
# small ledgers that every figure and statistic is computed from are tracked:
# experiments/results.csv and experiments/analysis/test_task_stats.csv.
# The bulky inputs they were derived from stay out.
experiments/logs/
experiments/plots/
experiments/*.db

# Bulky per-run console logs (regenerable; verdicts live in experiments/iterations + results.csv).
# Match subdirectories too (e.g. experiments/run_logs/) so they can't be re-committed.
experiments/*.log
experiments/**/*.log
experiments/run_logs/

# Iterator run artifacts (regenerable; committing them collides across experiment
# branches — the recurring PR-conflict source). Provenance lives in branch history.
experiments/iterations/
experiments/accepted_changes.md
experiments/rejected_changes.md
# Archived contaminated runs/plots (kept locally for reference, not committed).
experiments/archive_contaminated/

# Local tool state.
.pytest_cache/
.claude/

# TAU2 writes its embeddings cache to a cwd-relative data/ directory when the
# banking_knowledge domain runs. Regenerable, and the payload is ~16 MB.
data/
