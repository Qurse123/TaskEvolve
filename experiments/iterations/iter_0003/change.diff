--- a/target_agent/harness.py
+++ b/target_agent/harness.py
@@ -19,11 +19,39 @@
 ) -> list[Message]:
     """Return the full message list to pass to generate().
 
-    Static Arm A v0.1 harness: pass-through — system + history with no
-    compression, so the system prompt/policy is present on every turn. This is
-    the frozen baseline the open-weight arms (C/D) run against; the Arm B iterator
-    variant (v0.2, drop-system-after-turn-1) lives on its own branch.
+    Arm B iterator variant (t3): the system prompt / policy is expensive to
+    re-send on every turn because build_messages replays the entire growing
+    history plus the full system prompt each call. On high-turn tasks
+    (e.g. 34/31/31 turns) this makes cumulative input tokens scale with turn
+    count, which dominates total cost.
+
+    Change: keep the full system prompt only for the first turn (when history
+    is short enough that the model still needs the freshly-stated policy), and
+    drop the re-sent system prompt on subsequent turns once the policy is
+    already established in the conversation. The assistant has already seen and
+    acted on the policy earlier in the (retained) history, so re-sending it
+    verbatim every turn is redundant.
+
+    We define "turn 1" conservatively: the system prompt is included while the
+    conversation history is still empty or only contains the opening user
+    message(s). Once the assistant has produced at least one message (i.e. the
+    policy has demonstrably been consumed), we stop re-sending the system
+    prompt on every call, cutting the per-turn system-token overhead that
+    scales with turn count.
     """
+    # Determine whether the assistant has already engaged with the policy.
+    # role is exposed on tau2 Message objects; treat any assistant-authored
+    # message as evidence the system prompt has been consumed at least once.
+    assistant_has_spoken = any(
+        getattr(msg, "role", None) == "assistant" for msg in history
+    )
+
+    if assistant_has_spoken:
+        # Policy already established earlier in the retained history; skip the
+        # redundant re-send to save cumulative input tokens on high-turn tasks.
+        return [*history]
+
+    # Turn 1 (or pre-first-assistant-response): include the full policy.
     return [*system_messages, *history]
 
 
