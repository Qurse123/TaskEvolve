 from tau2.data_model.message import Message, SystemMessage
 from tau2.environment.tool import Tool
 
+# Sliding-window parameters
+_WINDOW_SIZE: int = 12           # keep this many most-recent dialogue turns verbatim
+_MAX_SUMMARY_LINES: int = 20     # cap on how many bullet lines go into the summary
+_MAX_CONTENT_CHARS: int = 60     # truncate each bullet to this length
+
+
+def _summarise(messages: Sequence[Message]) -> SystemMessage:
+    """Create a lightweight textual digest of the earlier dialogue.
+
+    We avoid an extra model call by using a rule-based summary: each omitted
+    message contributes one bullet listing its role and a truncated version of
+    its content. The summary is strictly shorter than keeping the raw messages
+    and still reminds the model of high-level context.
+    """
+    summary_lines: list[str] = []
+    for msg in messages[:_MAX_SUMMARY_LINES]:
+        # Defensive: guard against absent or non-string content
+        content = (getattr(msg, "content", "") or "").strip()
+        if len(content) > _MAX_CONTENT_CHARS:
+            content = content[: _MAX_CONTENT_CHARS - 3] + "..."
+        summary_lines.append(f"{msg.role}: {content}")
+    if len(messages) > _MAX_SUMMARY_LINES:
+        summary_lines.append("… (further turns omitted) …")
+
+    summary_text = (
+        "Summary of earlier dialogue (compressed for brevity):\n" + "\n".join(summary_lines)
+    )
+    return SystemMessage(content=summary_text)
+
 
