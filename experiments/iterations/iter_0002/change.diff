 """Model selection for TaskEvolveAgent.
 
-The iterator (Milestone 2+) may modify this file to add:
-- Cheap/strong routing based on turn count or confidence
-- Per-task-type model selection
+Routing policy: most turns in these tasks are conversational overhead
+(greetings, identity verification, order lookup, 'yes proceed' confirmations)
+that do not require strong reasoning. We route such simple turns to the
+cheapest model (claude-haiku-4-5) and reserve stronger models for turns that
+involve genuine multi-item / decision reasoning.
 """
 
 from __future__ import annotations
 
 
+# Keywords that signal a genuinely complex, decision-heavy turn where we want
+# the strongest reasoning available. These correspond to multi-item choices,
+# refunds/cancellations, and ambiguous requests.
+_COMPLEX_KEYWORDS = (
+    "cancel",
+    "refund",
+    "exchange",
+    "return",
+    "replace",
+    "modify",
+    "change order",
+    "multiple",
+    "instead",
+    "however",
+    "but also",
+    "as well as",
+    "combine",
+    "discount",
+    "price adjust",
+    "which one",
+    "either",
+    "compare",
+)
+
+
+def _text_of(msg) -> str:
+    """Best-effort extraction of textual content from a message object/dict."""
+    content = None
+    if isinstance(msg, dict):
+        content = msg.get("content")
+        role = msg.get("role")
+    else:
+        content = getattr(msg, "content", None)
+        role = getattr(msg, "role", None)
+    _ = role
+    if content is None:
+        return ""
+    if isinstance(content, str):
+        return content
+    # content may be a list of blocks
+    parts = []
+    try:
+        for block in content:
+            if isinstance(block, dict):
+                t = block.get("text") or block.get("content")
+                if isinstance(t, str):
+                    parts.append(t)
+            else:
+                t = getattr(block, "text", None)
+                if isinstance(t, str):
+                    parts.append(t)
+    except TypeError:
+        return str(content)
+    return " ".join(parts)
+
+
+def _last_user_text(history) -> str:
+    if not history:
+        return ""
+    for msg in reversed(history):
+        if isinstance(msg, dict):
+            role = msg.get("role")
+        else:
+            role = getattr(msg, "role", None)
+        if role == "user":
+            return _text_of(msg)
+    # fall back to last message text
+    return _text_of(history[-1])
+
+
 def get_model(configured_model: str, history=None) -> str:
     """Return the model to use for the current generation call.
 
-    ``history`` is the conversation so far (the agent passes ``state.messages``),
-    so a routing policy can branch on context — e.g. a cheap model for simple
-    early turns, a strong model for complex later ones. This baseline is the
-    identity: it ignores ``history`` and always returns the configured model.
-    The iterator (Exp 2) may rewrite this into a cost-aware routing policy over
-    the allowed model pool.
+    Policy:
+    - If there is no history yet (first turn), use the configured model so the
+      task is set up with full capability.
+    - If the most recent user turn contains keywords signalling a complex,
+      multi-item or decision-heavy request, keep the configured (strong) model.
+    - Otherwise treat the turn as simple conversational overhead and route to
+      the cheapest model (haiku), which cuts per-token cost ~5x on the bulk of
+      turns while preserving success on trivial confirmation/lookup turns.
+
+    We never upgrade above the configured model, so this only ever reduces cost.
     """
-    return configured_model
+    cheap_model = "anthropic/claude-haiku-4-5"
+
+    # No context yet: keep configured strength for initial planning.
+    if not history:
+        return configured_model
+
+    text = _last_user_text(history).lower()
+
+    # Complex/decision turn -> keep the strong configured model.
+    for kw in _COMPLEX_KEYWORDS:
+        if kw in text:
+            return configured_model
+
+    # If the configured model is already the cheap one, nothing to do.
+    if configured_model == cheap_model:
+        return configured_model
+
+    # Simple conversational turn -> route to the cheapest model.
+    return cheap_model
