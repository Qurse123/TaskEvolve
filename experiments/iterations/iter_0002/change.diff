+def _mentioned_tools(tools: List[Tool]) -> set[str]:
+    """Return the lower-cased names of tools that are mentioned in recent msgs."""
+    if not _RECENT_MESSAGES:
+        return set()
+
+    combined_text = "\n".join(
+        (
+            (getattr(m, "name", "") or "") + " " + (m.content or "")
+            if hasattr(m, "content")
+            else (getattr(m, "name", "") or "")
+        )
+        for m in _RECENT_MESSAGES
+    ).lower()
+
+    return {t.name for t in tools if t.name.lower() in combined_text}
 
 
