--- a/target_agent/prompts/policy_summary.j2
+++ b/target_agent/prompts/policy_summary.j2
@@ -1 +1,10 @@
-{{ domain_policy }}
+{% set lines = domain_policy.split('\n') %}
+{%- for line in lines -%}
+{%- set stripped = line.strip() -%}
+{%- if stripped -%}
+{%- set low = stripped.lower() -%}
+{%- if low.startswith('you must') or low.startswith('you should') or low.startswith('always') or low.startswith('never') or low.startswith('do not') or low.startswith('don\'t') or low.startswith('must') or low.startswith('cannot') or low.startswith('can not') or ' must ' in low or ' must not ' in low or ' may not ' in low or ' are not allowed' in low or 'is not allowed' in low or 'are required' in low or 'is required' in low or 'only if' in low or 'unless' in low or low.startswith('- ') or low.startswith('* ') or (stripped[0] is defined and stripped[0].isdigit()) -%}
+{{ stripped }}
+{% endif -%}
+{%- endif -%}
+{%- endfor -%}
