-def filter_tools(tools: list[Tool]) -> list[Tool]:
+def _first_sentence(text: str) -> str:
+    """Return the first sentence (trimmed) from the input text."""
+    sent = text.split(".")[0].strip()
+    return sent + "." if not sent.endswith(".") else sent
+
+
+def filter_tools(tools: List[Tool]) -> List[Tool]:
     """Return the tool list to expose to the LLM.
 
-    M1: pass-through — all tools exposed unchanged.
-    Iterator can narrow the set or rewrite descriptions here.
+    M3 (ticket t5): shorten each tool description to its first sentence to cut
+    tokens while leaving the JSON schema and functionality intact.
     """
-    return list(tools)
+    shortened: List[Tool] = []
+    for t in tools:
+        # Only attempt to shorten if a non-empty description attribute exists.
+        desc = getattr(t, "description", None)
+        if isinstance(desc, str) and desc:
+            short_desc = _first_sentence(desc)
+            # dataclasses.replace preserves all fields except those we change.
+            try:
+                t_shrunk = replace(t, description=short_desc)
+            except TypeError:
+                # Fallback: mutate directly if replace fails (e.g., not frozen).
+                try:
+                    t.description = short_desc  # type: ignore[attr-defined]
+                except Exception:
+                    pass  # If mutation fails, leave as-is.
+                t_shrunk = t
+        else:
+            t_shrunk = t
+        shortened.append(t_shrunk)
+    return shortened
