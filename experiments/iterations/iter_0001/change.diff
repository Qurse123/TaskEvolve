+from tau2.data_model.message import Message, SystemMessage, ToolMessage
 from tau2.environment.tool import Tool
+
+# Keep the most recent N tool results verbatim; older ones get truncated.
+# The agent typically only needs full detail from recent tool calls; older
+# large JSON blobs (e.g. get_order_details) are re-sent every turn otherwise.
+_KEEP_RECENT_TOOL_RESULTS = 4
+_TRUNCATE_THRESHOLD_CHARS = 600
+_TRUNCATE_KEEP_CHARS = 400
+
+
+def _content_text(content) -> str | None:
+    if isinstance(content, str):
+        return content
+    return None
+
+
+def _compress_tool_message(msg: ToolMessage) -> ToolMessage:
+    """Return a copy of a ToolMessage with a truncated content blob.
+
+    Only truncates plain-string content that exceeds the threshold. Leaves
+    non-string / structured content untouched to avoid breaking parsing.
+    """
+    text = _content_text(msg.content)
+    if text is None or len(text) <= _TRUNCATE_THRESHOLD_CHARS:
+        return msg
+    truncated = (
+        text[:_TRUNCATE_KEEP_CHARS]
+        + f"\n...[older tool result truncated: {len(text) - _TRUNCATE_KEEP_CHARS} chars omitted]"
+    )
+    new_msg = copy.copy(msg)
+    new_msg.content = truncated
+    return new_msg
 
 
