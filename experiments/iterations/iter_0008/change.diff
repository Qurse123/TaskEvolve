--- a/target_agent/harness.py
+++ b/target_agent/harness.py
@@ -27,10 +27,25 @@
     return [*system_messages, *history]
 
 
+# Tools that are near-unused in the retail task distribution (t3 hypothesis):
+# transfer_to_human_agents (1 call observed) and calculate (2 calls observed).
+# Their schemas are resent every turn (~28.5 turns/task), adding fixed per-turn
+# input-token overhead without meaningfully expanding the used action space.
+_RARELY_USED_TOOLS = frozenset({
+    "transfer_to_human_agents",
+    "calculate",
+})
+
+
 def filter_tools(tools: list[Tool]) -> list[Tool]:
     """Return the tool list to expose to the LLM.
 
-    M1: pass-through — all tools exposed unchanged.
-    Iterator can narrow the set or rewrite descriptions here.
+    t3: drop the rarely/never-used tools from the exposed set so their schemas
+    are not resent on every turn. This trims fixed per-turn tool-schema tokens
+    while leaving the retail-relevant action space the agent actually uses
+    intact. Falls back to pass-through if filtering would remove everything.
     """
-    return list(tools)
+    filtered = [t for t in tools if getattr(t, "name", None) not in _RARELY_USED_TOOLS]
+    if not filtered:
+        return list(tools)
+    return filtered
