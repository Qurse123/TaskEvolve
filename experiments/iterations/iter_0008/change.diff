--- a/target_agent/harness.py
+++ b/target_agent/harness.py
@@ -27,10 +27,50 @@
     return [*system_messages, *history]
 
 
+# Commonly-used retail action tools that cover nearly all calls in the run.
+# Rarely-used tools (e.g. transfer_to_human_agents, modify_user_address) are
+# pruned from the per-turn schema to reduce fixed input-token cost, but only
+# when they are not actually needed. To keep task success as a hard floor, we
+# prune ONLY tools outside this allow-list AND we never drop below the set that
+# the agent might reasonably need — if the incoming tool set is small we leave
+# it untouched.
+_COMMON_RETAIL_TOOLS = frozenset(
+    {
+        "get_order_details",
+        "get_user_details",
+        "find_user_id_by_email",
+        "find_user_id_by_name_zip",
+        "cancel_pending_order",
+        "return_delivered_order_items",
+        "exchange_delivered_order_items",
+        "modify_pending_order_items",
+        "get_product_details",
+        "list_all_product_types",
+        "calculate",
+    }
+)
+
+
 def filter_tools(tools: list[Tool]) -> list[Tool]:
     """Return the tool list to expose to the LLM.
 
-    M1: pass-through — all tools exposed unchanged.
-    Iterator can narrow the set or rewrite descriptions here.
+    Prune rarely-used tools from the schema each turn to shrink fixed per-turn
+    input-token cost. The tool schema is re-sent on every turn (~27 turns/task),
+    so removing tools that are essentially never called (e.g.
+    transfer_to_human_agents, modify_user_address) reduces input tokens per turn
+    with negligible risk to success.
+
+    Safety guard: if fewer than or equal to the allow-list size of tools are
+    provided, pass through unchanged to avoid over-pruning in unexpected setups.
     """
-    return list(tools)
+    all_tools = list(tools)
+    if len(all_tools) <= len(_COMMON_RETAIL_TOOLS):
+        return all_tools
+
+    pruned = [t for t in all_tools if getattr(t, "name", None) in _COMMON_RETAIL_TOOLS]
+
+    # Never expose an empty tool list; if the allow-list matched nothing (name
+    # mismatch / different task domain), fall back to the full set.
+    if not pruned:
+        return all_tools
+    return pruned
