 from tau2.environment.tool import Tool
+
+
+# Fields the agent actually references from a get_order_details result.
+# Everything else (addresses, per-item metadata bloat, timestamps, tracking,
+# fulfillment internals, etc.) is dropped to shrink re-sent input tokens.
+_KEEP_TOP_LEVEL = {"order_id", "status"}
+_KEEP_ITEM_FIELDS = {"item_id", "name", "product_id", "options", "price"}
+
+
+def _compress_item(item: Any) -> Any:
+    if not isinstance(item, dict):
+        return item
+    return {k: v for k, v in item.items() if k in _KEEP_ITEM_FIELDS}
+
+
+def _compress_order_payload(payload: dict) -> dict:
+    """Keep only decision-relevant fields: order_id, status, and item
+    options/prices. Preserves every order (no truncation of older blobs),
+    only removes address/metadata bloat within each blob.
+    """
+    compressed: dict[str, Any] = {}
+    for k, v in payload.items():
+        if k in _KEEP_TOP_LEVEL:
+            compressed[k] = v
+        elif k == "items" and isinstance(v, list):
+            compressed["items"] = [_compress_item(it) for it in v]
+    return compressed
+
+
+def _looks_like_order_details(payload: dict) -> bool:
+    # Only compress blobs that are clearly get_order_details results:
+    # they carry an order_id and an items list. This avoids touching
+    # unrelated tool results.
+    return (
+        "order_id" in payload
+        and "items" in payload
+        and isinstance(payload.get("items"), list)
+    )
+
+
+def _compress_tool_message(msg: ToolMessage) -> ToolMessage:
+    content = getattr(msg, "content", None)
+    if not isinstance(content, str) or not content.strip():
+        return msg
+
+    # Attempt to parse the tool result as JSON. If it isn't a single JSON
+    # object that looks like an order-details blob, leave it untouched.
+    try:
+        parsed = json.loads(content)
+    except (json.JSONDecodeError, ValueError):
+        return msg
+
+    if not isinstance(parsed, dict) or not _looks_like_order_details(parsed):
+        return msg
+
+    compressed = _compress_order_payload(parsed)
+    new_content = json.dumps(compressed, separators=(",", ":"))
+
+    # If compression didn't actually shrink anything, keep the original.
+    if len(new_content) >= len(content):
+        return msg
+
+    return msg.model_copy(update={"content": new_content})
 
 
