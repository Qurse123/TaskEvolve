--- a/target_agent/model_routing.py
+++ b/target_agent/model_routing.py
@@ -7,12 +7,120 @@
 
 from __future__ import annotations
 
+import inspect
+
+# Substrings that mark a turn as mechanical order-enumeration / lookup work:
+# identity verification prompts and bulk get_order_details fan-outs. These are
+# simple pattern-matching turns where gpt-4.1-mini is sufficient. Reasoning-
+# critical turns (returns/exchanges/cancellations decisions, policy judgement)
+# stay on the configured strong model.
+_MECHANICAL_MARKERS = (
+    "get_order_details",
+    "list_orders",
+    "find_user_id",
+    "get_user_details",
+    "verify",
+    "identity",
+    "order id",
+    "order_id",
+    "which order",
+    "look up",
+    "lookup",
+)
+
+# Markers that force the strong model even if a mechanical marker also appears.
+_REASONING_MARKERS = (
+    "cancel",
+    "return",
+    "exchange",
+    "refund",
+    "modify",
+    "policy",
+    "cannot",
+    "eligib",
+    "decide",
+    "should i",
+)
+
+
+def _scan_context_text() -> str:
+    """Best-effort scan of caller frames for prompt/message text.
+
+    We look up the call stack for local variables that plausibly hold the
+    current conversation/prompt text, so routing can be decided without
+    changing the agent's call signature. Returns lowercased concatenated text
+    (may be empty if nothing is found).
+    """
+    collected: list[str] = []
+    try:
+        frame = inspect.currentframe()
+        depth = 0
+        while frame is not None and depth < 8:
+            for name, val in frame.f_locals.items():
+                lname = name.lower()
+                if not any(
+                    key in lname
+                    for key in ("prompt", "message", "messages", "content", "turn", "input", "text")
+                ):
+                    continue
+                try:
+                    if isinstance(val, str):
+                        collected.append(val)
+                    elif isinstance(val, (list, tuple)):
+                        for item in val:
+                            if isinstance(item, str):
+                                collected.append(item)
+                            elif isinstance(item, dict):
+                                c = item.get("content")
+                                if isinstance(c, str):
+                                    collected.append(c)
+                    elif isinstance(val, dict):
+                        c = val.get("content")
+                        if isinstance(c, str):
+                            collected.append(c)
+                except Exception:
+                    continue
+            frame = frame.f_back
+            depth += 1
+    except Exception:
+        return ""
+    finally:
+        del frame  # avoid reference cycles
+    return "\n".join(collected).lower()
+
 
 def get_model(configured_model: str) -> str:
     """Return the model to use for the current generation call.
 
-    Static Arm A v0.1 harness: pass-through — always uses the model set at agent
-    init time (the configured open-weight or closed model). No cheap-model
-    routing. The Arm B iterator routing variant lives on its own branch.
+    Hybrid routing (ticket t1): keep the configured strong model (gpt-4.1) for
+    reasoning-critical turns, but downgrade mechanical order-enumeration /
+    identity-verification / bulk get_order_details lookup turns to
+    gpt-4.1-mini. This targets the dominant cost driver (repeated per-order
+    get_order_details fan-outs) while preserving capability on decision turns
+    so success stays at/above the floor.
+
+    Fails safe: if we cannot confidently classify the turn as mechanical, we
+    return the configured model unchanged.
     """
+    # Only ever downgrade FROM the strong model. If the caller already
+    # configured mini, respect it. Never route to anything other than the two
+    # allowed model names.
+    if configured_model != "gpt-4.1":
+        return configured_model
+
+    text = _scan_context_text()
+    if not text:
+        # No context available -> fail safe to strong model.
+        return configured_model
+
+    # If any reasoning marker is present, keep the strong model.
+    if any(marker in text for marker in _REASONING_MARKERS):
+        return configured_model
+
+    # Otherwise, if this looks like a mechanical lookup/enumeration turn,
+    # downgrade to the cheap model.
+    if any(marker in text for marker in _MECHANICAL_MARKERS):
+        return "gpt-4.1-mini"
+
+    # Default: strong model.
     return configured_model
