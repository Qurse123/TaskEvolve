+from tau2.data_model.message import Message, SystemMessage, ToolMessage
 from tau2.environment.tool import Tool
+
+# Tool outputs from these tools are large multi-variant / multi-order JSON blobs.
+# Once they've been consumed (i.e., they are not the most recent tool results),
+# replaying them verbatim on every subsequent turn burns context tokens without
+# adding decision-relevant signal. We compress *stale* copies only.
+_BULKY_TOOLS = {"get_product_details", "get_order_details"}
+
+# Only compress when the serialized content is genuinely large; small results are
+# left untouched so we don't perturb short tasks.
+_COMPRESS_MIN_CHARS = 600
+
+# How many most-recent tool messages to leave fully intact (the agent may still
+# be actively reasoning over the latest fetch).
+_KEEP_RECENT_TOOL_MSGS = 2
+
+
+def _content_len(msg: ToolMessage) -> int:
+    content = getattr(msg, "content", None)
+    if content is None:
+        return 0
+    if isinstance(content, str):
+        return len(content)
+    try:
+        return len(json.dumps(content))
+    except (TypeError, ValueError):
+        return len(str(content))
+
+
+def _tool_name(msg: ToolMessage) -> str | None:
+    # ToolMessage may expose the originating tool name under a few attributes
+    # depending on schema version; probe defensively.
+    for attr in ("name", "tool_name", "tool"):
+        val = getattr(msg, attr, None)
+        if isinstance(val, str) and val:
+            return val
+    return None
+
+
+def _compress(msg: ToolMessage) -> ToolMessage:
+    """Return a copy of a stale bulky tool message with its content elided.
+
+    We keep a short marker so the model knows the fetch happened and succeeded,
+    but drop the verbose variant/order payload that was already acted upon.
+    """
+    new_msg = copy.copy(msg)
+    name = _tool_name(msg) or "tool"
+    new_msg.content = (
+        f"[stale {name} result elided to save context; "
+        f"re-call the tool if these details are needed again]"
+    )
+    return new_msg
 
 
