 """Model selection for TaskEvolveAgent.
 
-The iterator (Milestone 2+) may modify this file to add:
-- Cheap/strong routing based on turn count or confidence
-- Per-task-type model selection
+Routing policy (ticket t3): route ONLY pure yes/no confirmation turns to the
+cheapest model (claude-haiku-4-5). Any turn that involves a pending tool
+decision or a multi-item choice keeps the configured (reasoning-heavy) model.
+
+This is a deliberately narrow rule: it fires only when the last user message is
+a short affirmative/negative confirmation and there is no tool call in flight.
+The prior, broader attempt routed lookups AND identity checks to haiku and
+crossed the success floor; here we exclude every decision/tool turn so
+reasoning-heavy steps are untouched.
 """
 
 from __future__ import annotations
+
+HAIKU = "anthropic/claude-haiku-4-5"
+
+# Short confirmation phrases. The last user message must reduce to one of these
+# (after stripping punctuation/whitespace/casing) to qualify for haiku.
+_CONFIRMATION_PHRASES = {
+    "yes",
+    "yes please",
+    "yes please go ahead",
+    "please go ahead",
+    "go ahead",
+    "yes go ahead",
+    "yep",
+    "yeah",
+    "sure",
+    "ok",
+    "okay",
+    "confirm",
+    "confirmed",
+    "correct",
+    "that is correct",
+    "thats correct",
+    "no",
+    "no thanks",
+    "nope",
+    "sounds good",
+    "proceed",
+    "do it",
+}
+
+
+def _text_of(msg) -> str:
+    """Best-effort extraction of plain text from a history message."""
+    if msg is None:
+        return ""
+    content = None
+    if isinstance(msg, dict):
+        content = msg.get("content")
+        if content is None:
+            content = msg.get("text")
+    else:
+        content = getattr(msg, "content", None)
+        if content is None:
+            content = getattr(msg, "text", None)
+    if content is None:
+        return ""
+    if isinstance(content, str):
+        return content
+    # content may be a list of parts (blocks); concatenate any text parts.
+    if isinstance(content, (list, tuple)):
+        parts = []
+        for part in content:
+            if isinstance(part, str):
+                parts.append(part)
+            elif isinstance(part, dict):
+                t = part.get("text") or part.get("content")
+                if isinstance(t, str):
+                    parts.append(t)
+            else:
+                t = getattr(part, "text", None)
+                if isinstance(t, str):
+                    parts.append(t)
+        return " ".join(parts)
+    return str(content)
+
+
+def _role_of(msg) -> str:
+    if isinstance(msg, dict):
+        return str(msg.get("role", ""))
+    return str(getattr(msg, "role", ""))
+
+
+def _normalize(text: str) -> str:
+    keep = [c.lower() if c.isalnum() else " " for c in text]
+    return " ".join("".join(keep).split())
+
+
+def _has_pending_tool_decision(msg) -> bool:
+    """True if the message carries a tool call / tool result, signalling a
+    decision or tool interaction rather than a pure confirmation."""
+    if msg is None:
+        return False
+    if isinstance(msg, dict):
+        if msg.get("tool_calls") or msg.get("tool_call_id") or msg.get("function_call"):
+            return True
+        if msg.get("role") in ("tool", "function"):
+            return True
+        content = msg.get("content")
+    else:
+        if getattr(msg, "tool_calls", None) or getattr(msg, "tool_call_id", None):
+            return True
+        if getattr(msg, "role", None) in ("tool", "function"):
+            return True
+        content = getattr(msg, "content", None)
+    if isinstance(content, (list, tuple)):
+        for part in content:
+            ptype = None
+            if isinstance(part, dict):
+                ptype = part.get("type")
+            else:
+                ptype = getattr(part, "type", None)
+            if ptype and "tool" in str(ptype).lower():
+                return True
+    return False
 
 
 def get_model(configured_model: str, history=None) -> str:
     """Return the model to use for the current generation call.
 
-    ``history`` is the conversation so far (the agent passes ``state.messages``),
-    so a routing policy can branch on context — e.g. a cheap model for simple
-    early turns, a strong model for complex later ones. This baseline is the
-    identity: it ignores ``history`` and always returns the configured model.
-    The iterator (Exp 2) may rewrite this into a cost-aware routing policy over
-    the allowed model pool.
+    Route to haiku ONLY when the last user message is a short yes/no style
+    confirmation and there is no pending tool decision in the recent context.
+    Otherwise keep the configured model (unchanged behaviour for every
+    reasoning-heavy or tool/decision turn).
     """
-    return configured_model
+    if not history:
+        return configured_model
+
+    try:
+        messages = list(history)
+    except TypeError:
+        return configured_model
+
+    if not messages:
+        return configured_model
+
+    # Find the last user message.
+    last_user = None
+    last_user_idx = None
+    for i in range(len(messages) - 1, -1, -1):
+        if _role_of(messages[i]) == "user":
+            last_user = messages[i]
+            last_user_idx = i
+            break
+
+    if last_user is None:
+        return configured_model
+
+    # If the latest message overall is not the user's (e.g. a tool result is
+    # pending), don't treat this as a plain confirmation turn.
+    if last_user_idx != len(messages) - 1:
+        return configured_model
+
+    norm = _normalize(_text_of(last_user))
+    if not norm:
+        return configured_model
+
+    # Must be short and exactly a known confirmation phrase.
+    if len(norm.split()) > 4:
+        return configured_model
+    if norm not in _CONFIRMATION_PHRASES:
+        return configured_model
+
+    # Exclude turns where a tool decision is pending in recent context.
+    for msg in messages[-3:]:
+        if _has_pending_tool_decision(msg):
+            return configured_model
+
+    return HAIKU
