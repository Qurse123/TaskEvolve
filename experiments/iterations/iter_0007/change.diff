+    if len(history) < 3:
+        return False
+
+    last, prev, prior = history[-1], history[-2], history[-3]
+
+    return (
+        last.get("role") == "user"
+        and prev.get("role") == "assistant"
+        and prior.get("role") == "tool"
+    )
+
