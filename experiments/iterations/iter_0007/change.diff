 from typing import Sequence
 
-from tau2.data_model.message import Message, SystemMessage
+from tau2.data_model.message import (
+    Message,
+    SystemMessage,
+    ToolMessage,
+)
 from tau2.environment.tool import Tool
+
+# Keep the most recent N tool results in full; older tool-result payloads are
+# compressed to a short stub. This preserves the *decisions* (assistant/user
+# turns and recent tool outputs the model is actively reasoning over) while
+# dropping stale, bulky JSON blobs (e.g. repeated get_order_details objects)
+# that would otherwise be resent verbatim on every subsequent turn.
+_KEEP_RECENT_TOOL_RESULTS = 4
+
+# Only bother compressing payloads above this character budget; small results
+# are cheap and stubbing them adds no value.
+_MIN_PAYLOAD_CHARS = 200
+
+_STUB_TEMPLATE = (
+    "[tool result elided to save context; "
+    "{n} chars of prior output for this call omitted]"
+)
+
+
+def _tool_result_len(msg: ToolMessage) -> int:
+    content = getattr(msg, "content", None)
+    if isinstance(content, str):
+        return len(content)
+    if content is None:
+        return 0
+    return len(str(content))
+
+
+def _compress_history(history: Sequence[Message]) -> list[Message]:
+    """Drop stale tool-result payloads while keeping all decisions.
+
+    Strategy:
+    - Identify indices of ToolMessages in order.
+    - Keep the last ``_KEEP_RECENT_TOOL_RESULTS`` tool results untouched.
+    - For older tool results whose payload exceeds ``_MIN_PAYLOAD_CHARS``,
+      replace the content with a compact stub. All non-tool messages
+      (system/assistant/user), tool_call metadata, ids, and ordering are
+      preserved verbatim so the conversation's decision trail is intact.
+    """
+    tool_indices = [
+        i for i, m in enumerate(history) if isinstance(m, ToolMessage)
+    ]
+    if len(tool_indices) <= _KEEP_RECENT_TOOL_RESULTS:
+        return list(history)
+
+    # Indices whose payloads are eligible to be stubbed (all but the most recent).
+    stub_targets = set(tool_indices[:-_KEEP_RECENT_TOOL_RESULTS])
+
+    out: list[Message] = []
+    for i, msg in enumerate(history):
+        if i in stub_targets and isinstance(msg, ToolMessage):
+            n = _tool_result_len(msg)
+            if n >= _MIN_PAYLOAD_CHARS:
+                try:
+                    stub = msg.model_copy(
+                        update={"content": _STUB_TEMPLATE.format(n=n)}
+                    )
+                    out.append(stub)
+                    continue
+                except Exception:
+                    # If copy/update fails for any reason, fall back to
+                    # passing the original message through unchanged.
+                    pass
+        out.append(msg)
+    return out
 
 
