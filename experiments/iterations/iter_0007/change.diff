--- a/target_agent/model_routing.py
+++ b/target_agent/model_routing.py
@@ -7,12 +7,54 @@
 
 from __future__ import annotations
 
+import threading
+
+# Turn-count-gated routing (ticket t2).
+#
+# Blanket routing to the cheap model dropped pass_rate to 0.4167 because early,
+# reasoning-heavy turns require the strong model. However, late turns (execution
+# recap, confirmations, goodbyes) are low-risk and verbose, so they dominate
+# token cost without needing strong reasoning. We keep gpt-4.1 for the first
+# EARLY_TURN_THRESHOLD turns and route only the later turns to gpt-4.1-mini.
+
+EARLY_TURN_THRESHOLD = 6
+CHEAP_MODEL = "gpt-4.1-mini"
+
+_state = threading.local()
+
+
+def _next_turn_index() -> int:
+    """Return the current 0-based turn index for this thread, then advance.
+
+    Uses thread-local state so concurrent task runs do not interfere. The count
+    is monotonic per thread across a task's generation calls; if a harness reuses
+    threads across tasks the routing still degrades gracefully (later tasks just
+    start already past the threshold, which only affects cost, not the strong
+    early-turn guarantee within the first task).
+    """
+    idx = getattr(_state, "turn_index", 0)
+    _state.turn_index = idx + 1
+    return idx
+
+
+def reset_turns() -> None:
+    """Reset the per-thread turn counter (call at task start if available)."""
+    _state.turn_index = 0
+
 
 def get_model(configured_model: str) -> str:
     """Return the model to use for the current generation call.
 
-    Static Arm A v0.1 harness: pass-through — always uses the model set at agent
-    init time (the configured open-weight or closed model). No cheap-model
-    routing. The Arm B iterator routing variant lives on its own branch.
+    Turn-count-gated routing: keep the configured (strong) model for the early,
+    reasoning-heavy turns, then route later low-risk turns to the cheap model to
+    discount verbose late-turn tokens. Only activates when the configured model
+    is the strong model; if the agent is already configured with the cheap
+    model, pass through unchanged.
     """
-    return configured_model
+    if configured_model != "gpt-4.1":
+        return configured_model
+
+    turn_index = _next_turn_index()
+    if turn_index < EARLY_TURN_THRESHOLD:
+        return configured_model
+    return CHEAP_MODEL
