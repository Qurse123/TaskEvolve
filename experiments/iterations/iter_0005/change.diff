 from tau2.data_model.message import Message, SystemMessage
 from tau2.environment.tool import Tool
 
+# Keep at most this many user/assistant exchanges (pair of messages) in context
+_MAX_EXCHANGES_TO_KEEP = 10  # 10 exchanges ≈ 20 messages
+
+
+def _trim_history(history: Sequence[Message]) -> list[Message]:
+    """Return the most recent portion of history, capped by _MAX_EXCHANGES_TO_KEEP.
+
+    One *exchange* is a user→assistant pair, so we keep 2×N messages.
+    This sliding-window is a simple, safe way to bound context length.
+    """
+    max_msgs = _MAX_EXCHANGES_TO_KEEP * 2  # user + assistant per exchange
+    if len(history) <= max_msgs:
+        return list(history)
+    return list(history[-max_msgs:])
+
 
