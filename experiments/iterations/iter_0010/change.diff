 from tau2.data_model.message import Message, SystemMessage
 from tau2.environment.tool import Tool
 
+# --- TUNABLES --------------------------------------------------------------
+# Character length beyond which a tool message is considered "large".
+_TOOL_MSG_TRUNCATE_THRESHOLD = 300  # ~75 tokens
+# How many characters of the original payload to keep before the placeholder.
+_TOOL_MSG_HEAD_CHARS = 200  # keep key fields / structure
+# --------------------------------------------------------------------------
+
+
+def _compress_history(history: Sequence[Message]) -> list[Message]:
+    """Return a copy of *history* with bulky tool-response payloads truncated.
+
+    After the assistant has already parsed a tool response, the raw JSON no
+    longer needs to stay verbatim in the prompt.  Replacing it with a stub
+    keeps the causal chain visible (tool was called, result came back) while
+    shrinking token count for all subsequent turns.
+    """
+    compressed: list[Message] = []
+
+    for msg in history:
+        # Only tamper with tool responses that are clearly large.
+        if (
+            msg.role == "tool"
+            and isinstance(msg.content, str)
+            and len(msg.content) > _TOOL_MSG_TRUNCATE_THRESHOLD
+        ):
+            # Preserve the first chunk (likely contains status / ids), then mark as truncated.
+            truncated_content = (
+                msg.content[:_TOOL_MSG_HEAD_CHARS].rstrip() + " …[truncated]"
+            )
+            # Re-instantiate a Message so we don't mutate the original object.
+            compressed.append(
+                Message(role=msg.role, content=truncated_content, name=getattr(msg, "name", None))
+            )
+        else:
+            compressed.append(msg)
+
+    return compressed
+
 
