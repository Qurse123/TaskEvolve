 from __future__ import annotations
 
-from typing import Sequence
+from typing import Sequence, List
 
 from tau2.data_model.message import Message, SystemMessage
 from tau2.environment.tool import Tool
 
+# --- Sliding-window parameters ---
+# Approximate maximum tokens from prior turns we want to keep in context.
+_MAX_HISTORY_TOKENS = 1500
+
+
+def _approx_token_count(text: str | None) -> int:
+    """Very light-weight token estimator.
+
+    We do NOT import heavy tokenizers at runtime; a simple word split keeps the
+    codebase lightweight and still gives us a useful proxy. One safety guard is
+    better than none, and slight over/under counts are okay for our purpose of
+    *roughly* bounding history size.
+    """
+    if not text:
+        return 0
+    # OpenAI tokens average ~¾ word; using words is a conservative estimate.
+    return len(text.split())
+
+
+def _estimate_message_tokens(msg: Message) -> int:
+    """Return a rough token count for an individual Message object."""
+    # Most Message subclasses expose a ``content`` string.  If that is missing
+    # (e.g. for tool calls encoded as Messages with arguments only), we fall
+    # back to 0 – such messages are typically short JSON dicts that will not
+    # blow up the context size.
+    return _approx_token_count(getattr(msg, "content", None))
+
+
+def _trim_history(history: Sequence[Message], max_tokens: int = _MAX_HISTORY_TOKENS) -> List[Message]:
+    """Return the most-recent slice of *history* whose estimated size ≤ max_tokens.
+
+    We walk the history backwards so that we always retain the *latest* turns –
+    exactly what matters for coherence – and drop only the oldest ones.  Each
+    item is a proper ``Message`` instance, so we never lose required ``role``
+    fields (the root cause of the earlier crash referenced in ticket t2).
+    """
+    if not history:
+        return []
+
+    kept: List[Message] = []
+    running_total = 0
+
+    for msg in reversed(history):  # newest → oldest
+        token_estimate = _estimate_message_tokens(msg)
+        running_total += token_estimate
+        kept.append(msg)
+        if running_total >= max_tokens:
+            break  # We have enough recent context; older turns can be dropped.
+
+    # Reverse again to restore chronological order.
+    kept.reverse()
+    return kept
+
+
